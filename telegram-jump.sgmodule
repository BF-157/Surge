#!name=Telegram 跳转
#!desc=点 t.me / telegram.me 链接时跳转到你选的 Telegram 客户端。默认官方 Telegram；访问 t.me/__tgclient__/sg 这类链接即可切换（tg/na/sg/tu/im/ng/li/re），偏好保存在 Surge 本地。一个模块通吃，不依赖模块参数表。
#!system=ios

[Script]
telegram-jump = type=http-request,pattern=^https?://(t|telegram)\.me(?:\/|$),script-path=https://raw.githubusercontent.com/BF-157/Surge/main/scripts/telegram-jump.js,argument=TG

[MITM]
hostname = %APPEND% t.me, telegram.me
