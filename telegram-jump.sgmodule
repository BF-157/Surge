#!name=Telegram 多客户端跳转
#!desc=在模块参数里选客户端：点 t.me / telegram.me 链接时，跳到你选的 Telegram 客户端。参数留空时用 t.me/__tgclient__ 选择页保存的偏好，默认 TG。
#!arguments=client:SG
#!arguments-desc=客户端代号：TG=Telegram，NA=Nagram，SG=Swiftgram，TU=Turrit，IM=iMe，NG=Nicegram，LI=Lingogram，RE=Regram。也可以直接填真实 scheme（如 swiftgram）。
#!system=ios

[Script]
telegram-jump = type=http-request,pattern=^https?://(t|telegram)\.me(?:\/|$),script-path=https://cdn.jsdelivr.net/gh/BF-157/Surge@9e03e99/scripts/telegram-jump.js,argument="{{{client}}}"

[MITM]
hostname = %APPEND% t.me, telegram.me
