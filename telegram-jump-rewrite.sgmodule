#!name=Telegram 多客户端跳转
#!desc=通过修改模块参数切换 Telegram 客户端。参数填客户端 scheme（不是代号）。
#!arguments=client:swiftgram
#!arguments-desc=这里填 scheme，不是代号：tg=Telegram，swiftgram=Swiftgram，nagram=Nagram，turrit=Turrit，ime=iMe，nicegram=Nicegram，lingogram=Lingogram，regram=Regram
#!system=ios

[URL Rewrite]
# 频道帖子：t.me/name/123 -> <client>://resolve?domain=name&post=123
(https:\/\/)?t\.me\/([^\/\?]+)\/([0-9]+)(\?.*)? {{{client}}}://resolve?domain=$2&post=$3 302
# 频道：t.me/name -> <client>://resolve?domain=name
(https:\/\/)?t\.me\/([^\/\?]+)(\?.*)? {{{client}}}://resolve?domain=$2 302
# telegram.me 同上
(https:\/\/)?telegram\.me\/([^\/\?]+)\/([0-9]+)(\?.*)? {{{client}}}://resolve?domain=$2&post=$3 302
(https:\/\/)?telegram\.me\/([^\/\?]+)(\?.*)? {{{client}}}://resolve?domain=$2 302

[MITM]
hostname = %APPEND% t.me, telegram.me
