#!name=Telegram 跳转（纯规则）
#!desc=不依赖脚本、也不依赖模块参数：只把 t.me 的「频道」和「频道/帖子」链接 302 到官方 Telegram。邀请链接、t.me/s、share 等形态不支持，需要的话用 telegram-jump 脚本版。
#!system=ios

[URL Rewrite]
# 频道帖子：https://t.me/name/123 -> tg://resolve?domain=name&post=123
^https?://(?:t|telegram)\.me/([A-Za-z0-9_]{4,})/([0-9]+)/?$ tg://resolve?domain=$1&post=$2 302
# 频道：https://t.me/name -> tg://resolve?domain=name
^https?://(?:t|telegram)\.me/([A-Za-z0-9_]{4,})/?$ tg://resolve?domain=$1 302

[MITM]
hostname = %APPEND% t.me, telegram.me
